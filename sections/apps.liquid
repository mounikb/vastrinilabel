<section class="section app-section">
  <div class="{% if section.settings.include_page_width %}page-width{% endif %}">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="app-section__blocks">
      {%- for block in section.blocks -%}
        <div class="app-section__block" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "include_page_width", "label": "Use theme page width", "default": true }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "App section" }
  ]
}
{% endschema %}
